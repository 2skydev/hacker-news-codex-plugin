{
  "name": "hacker-news",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "description": "ChatGPT 구독으로 번역하는 Codex용 Hacker News 리더",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.ts",
    "test": "node --test",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
