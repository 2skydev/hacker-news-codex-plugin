{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@siwc/react/*": [
        "./node_modules/sign-in-with-chatgpt/packages/react/src/*"
      ]
    }
  },
  "include": [
    "ui",
    "server/*.ts"
  ]
}
