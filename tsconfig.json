{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./ui/kit/*"]
    },
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["ui", "server", "shared", "scripts", "test", "vite.config.ts"]
}
